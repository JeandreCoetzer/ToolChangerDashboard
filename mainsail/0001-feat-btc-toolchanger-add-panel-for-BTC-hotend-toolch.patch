+        <template #activator="{ on, attrs }">
+            <v-btn icon tile v-bind="attrs" :aria-label="$t('Panels.BtcToolchangerPanel.Settings')" v-on="on">
+                <v-icon small>{{ mdiCog }}</v-icon>
+            </v-btn>
+        </template>
+        <v-list>
+            <v-list-item class="minHeight36">
+                <v-select
+                    v-model="columns"
+                    :items="columnItems"
+                    :label="$t('Panels.BtcToolchangerPanel.TilesPerRow')"
+                    dense
+                    outlined
+                    hide-details
+                    class="mt-2" />
+            </v-list-item>
+            <v-list-item class="minHeight36">
+                <v-checkbox
+                    v-model="showStatus"
+                    class="mt-0"
+                    hide-details
+                    :label="$t('Panels.BtcToolchangerPanel.ShowStatus')" />
+            </v-list-item>
+            <v-list-item class="minHeight36">
+                <v-checkbox
+                    v-model="showActions"
+                    class="mt-0"
+                    hide-details
+                    :label="$t('Panels.BtcToolchangerPanel.ShowActions')" />
+            </v-list-item>
+            <v-list-item class="minHeight36">
+                <v-checkbox
+                    v-model="showLog"
+                    class="mt-0"
+                    hide-details
+                    :label="$t('Panels.BtcToolchangerPanel.ShowLog')" />
+            </v-list-item>
+        </v-list>
+    </v-menu>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import BtcToolchangerMixin from '@/components/mixins/btcToolchanger'
+import { mdiCog } from '@mdi/js'
+
+@Component
+export default class BtcToolchangerPanelSettings extends Mixins(BtcToolchangerMixin) {
+    mdiCog = mdiCog
+
+    get columnItems() {
+        return [
+            { text: this.$t('Panels.BtcToolchangerPanel.Auto'), value: 'auto' },
+            { text: '2', value: '2' },
+            { text: '3', value: '3' },
+            { text: '4', value: '4' },
+            { text: '6', value: '6' },
+            { text: '8', value: '8' },
+        ]
+    }
+
+    save(name: string, value: unknown) {
+        this.$store.dispatch('gui/saveSetting', { name: `view.btcToolchanger.${name}`, value })
+    }
+
+    get columns(): string {
+        return this.btcView?.columns ?? 'auto'
+    }
+    set columns(v: string) {
+        this.save('columns', v)
+    }
+
+    get showStatus(): boolean {
+        return this.btcView?.showStatus ?? true
+    }
+    set showStatus(v: boolean) {
+        this.save('showStatus', v)
+    }
+
+    get showActions(): boolean {
+        return this.btcView?.showActions ?? true
+    }
+    set showActions(v: boolean) {
+        this.save('showActions', v)
+    }
+
+    get showLog(): boolean {
+        return this.btcView?.showLog ?? false
+    }
+    set showLog(v: boolean) {
+        this.save('showLog', v)
+    }
+}
+</script>
