+    get presetsSourceText() {
+        if (!this.tool) return ''
+        const source = this.tool.presets_source ?? 'default'
+        return this.$t(`Panels.BtcToolchangerPanel.PresetsSource.${source}`, { n: this.tool.n })
+    }
+
+    get stateText() {
+        if (!this.tool) return ''
+        const base = this.$t(`Panels.BtcToolchangerPanel.StateLong.${this.kind}`).toString()
