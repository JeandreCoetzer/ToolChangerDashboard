+<template>
+    <button
+        type="button"
+        class="btc-tile"
+        :class="['btc-tile--' + kind]"
+        :style="tileStyle"
+        :aria-label="ariaLabel"
+        @click="$emit('open', tool.n)">
+        <span class="btc-tile__top">
+            <span class="btc-tile__id" :style="idStyle">{{ tool.name }}</span>
+            <span class="btc-tile__dot" :class="dotClass" :style="dotStyle" :title="dotTitle" />
+        </span>
+        <btc-toolchanger-hotend class="btc-tile__art" :color="look.color" :kind="kind" />
+        <span class="btc-tile__mat">
+            <span class="btc-tile__swatch" :style="{ backgroundColor: look.color || '#777' }" />
+            <span class="btc-tile__mat-txt">{{ look.material || $t('Panels.BtcToolchangerPanel.NoFilament') }}</span>
+        </span>
+        <span class="btc-tile__nums">
+            <span :class="{ 'text--disabled': !hot }">{{ tempText }}</span>
+            <span class="btc-tile__fan text--secondary">
+                <v-icon x-small class="mr-1">{{ mdiFan }}</v-icon>
+                {{ btcFormatFan(tool.fan_speed) }}
+            </span>
+        </span>
+    </button>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Prop } from 'vue-property-decorator'
+import BtcToolchangerMixin, { BtcTool } from '@/components/mixins/btcToolchanger'
+import BtcToolchangerHotend from '@/components/panels/BtcToolchanger/BtcToolchangerHotend.vue'
+import { mdiFan } from '@mdi/js'
+
+@Component({ components: { BtcToolchangerHotend } })
+export default class BtcToolchangerTile extends Mixins(BtcToolchangerMixin) {
+    @Prop({ type: Object, required: true }) declare readonly tool: BtcTool
+
+    mdiFan = mdiFan
+
+    get kind() {
+        return this.btcToolKind(this.tool)
+    }
+
+    get look() {
+        return this.btcToolLook(this.tool)
+    }
+
+    get hot() {
+        return this.tool.target > 0
+    }
+
+    get primaryColor(): string {
+        return this.$store.state.gui.uiSettings.primary
+    }
+
+    get tileStyle() {
+        if (this.kind !== 'active') return {}
+        return { borderColor: this.primaryColor, boxShadow: `inset 0 0 0 1px ${this.primaryColor}` }
+    }
+
+    get idStyle() {
+        return this.kind === 'active' ? { color: this.primaryColor } : {}
+    }
+
+    get dotClass() {
+        return {
+            'btc-tile__dot--sensed': this.tool.docked === true,
+            'btc-tile__dot--missing': this.tool.docked === false,
+        }
+    }
+
+    get dotStyle() {
+        if (this.kind === 'active') return { backgroundColor: this.primaryColor }
+        if (this.kind === 'standby') return { backgroundColor: 'var(--v-warning-base, #ffb74d)' }
+        return {}
+    }
+
+    get dotTitle() {
+        const state = this.$t(`Panels.BtcToolchangerPanel.State.${this.kind}`).toString()
+        if (this.tool.docked === true) return `${state}, ${this.$t('Panels.BtcToolchangerPanel.InDock')}`
+        if (this.tool.docked === false) return `${state}, ${this.$t('Panels.BtcToolchangerPanel.NotInDock')}`
+        return state
+    }
+
+    get tempText() {
+        const t = this.btcFormatTemp(this.tool.temperature)
+        if (!this.hot) return `${t}° ${this.$t('Panels.BtcToolchangerPanel.Off')}`
+        return `${t}/${this.btcFormatTemp(this.tool.target)}°`
+    }
+
+    get ariaLabel() {
+        return this.$t('Panels.BtcToolchangerPanel.TileLabel', {
+            name: this.tool.name,
+            material: this.look.material,
+            state: this.$t(`Panels.BtcToolchangerPanel.State.${this.kind}`),
+            temp: this.btcFormatTemp(this.tool.temperature),
+        }).toString()
+    }
+}
+</script>
