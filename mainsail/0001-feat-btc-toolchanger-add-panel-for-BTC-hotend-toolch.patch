@@ -0,0 +1,42 @@
+<template>
+    <svg :width="width" :height="height" viewBox="0 0 60 80" aria-hidden="true" class="btc-hotend">
+        <rect x="28" y="0" width="4" height="8" :fill="filament" />
+        <rect x="21" y="6" width="18" height="6" rx="2" :fill="filament" />
+        <rect x="24" y="12" width="12" height="30" fill="#5f646c" />
+        <rect v-for="y in fins" :key="y" x="14" :y="y" width="32" height="3" rx="1" fill="#8b9098" />
+        <rect x="27" y="42" width="6" height="8" fill="#b7bcc4" />
+        <rect x="16" y="50" width="28" height="14" rx="2" :fill="blockColor" />
+        <path d="M24 64h12l-4 8h-4z" fill="#c9a24a" />
+        <circle v-if="glow" cx="30" cy="75" r="5" :fill="glow" />
+    </svg>
+</template>
+
+<script lang="ts">
+import { Component, Prop, Vue } from 'vue-property-decorator'
+
+@Component
+export default class BtcToolchangerHotend extends Vue {
+    @Prop({ type: String, default: null }) declare readonly color: string | null
+    @Prop({ type: String, default: 'docked' }) declare readonly kind: 'active' | 'standby' | 'docked'
+    @Prop({ type: Number, default: 52 }) declare readonly width: number
+    @Prop({ type: Number, default: 70 }) declare readonly height: number
+
+    fins = [14, 20, 26, 32, 38]
+
+    get filament() {
+        return this.color ?? '#777777'
+    }
+
+    get blockColor() {
+        if (this.kind === 'active') return '#d84315'
+        if (this.kind === 'standby') return '#b86b2a'
+        return '#4a4f57'
+    }
+
+    get glow() {
+        if (this.kind === 'active') return 'rgba(255,112,67,0.55)'
+        if (this.kind === 'standby') return 'rgba(255,152,0,0.3)'
+        return null
+    }
+}
+</script>
