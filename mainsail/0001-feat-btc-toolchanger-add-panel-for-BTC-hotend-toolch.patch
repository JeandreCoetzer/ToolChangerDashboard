--- /dev/null
+++ b/src/components/mixins/btcToolchanger.ts
@@ -0,0 +1,201 @@
+import Component from 'vue-class-component'
+import BaseMixin from '@/components/mixins/base'
+import { ServerSpoolmanStateSpool } from '@/store/server/spoolman/types'
+
+/*
+ * Shared state helpers for the BTC (Bikin Toolchanger) panel.
+ * Data comes from the btc_dashboard Klipper add-on, which publishes
+ * printer.btc_dashboard (see https://github.com/JeandreCoetzer/ToolChangerDashboard).
+ */
+
+export interface BtcToolShaper {
+    type_x: string | null
+    freq_x: number | null
+    type_y: string | null
+    freq_y: number | null
+}
+
+export interface BtcTool {
+    n: number
+    name: string
+    active: boolean
+    extruder: string
+    fan: string
+    temperature: number | null
+    target: number
+    power: number
+    fan_speed: number | null
+    xoffset: number
+    yoffset: number
+    zoffset: number
+    shaper: BtcToolShaper
+    pressure_advance: number
+    spool_id: number | null
+    docked: boolean | null
+    presets?: BtcPreset[]
+    presets_source?: BtcPresetSource
+}
+
+export interface BtcPreset {
+    label: string
+    temp: number
+}
+
+// where a tool's presets come from: its _VARIABLES_Tn macro, a presets_tN option or the shared presets option
+export type BtcPresetSource = 'tool' | 'config' | 'default'
+
+export interface BtcLogEntry {
+    time: number
+    kind: 'pickup' | 'dropoff'
+    label: string
+    from: number
+    to: number
+    duration: number
+    result: 'ok' | 'fail'
+    detail: string
+}
+
+export interface BtcStatus {
+    version: string
+    config: {
+        tool_count: number
+        dock_sense: 'none' | 'per_tool'
+        dockslide: boolean
+        spoolman: 'auto' | 'yes' | 'no'
+        save_offsets: boolean
+        save_variables: boolean
+        carriage_sense: boolean
+        default_presets?: BtcPreset[]
+    }
+    active_tool: number
+    carriage: 'PRESSED' | 'RELEASED' | null
+    busy: boolean
+    last_dropoff_successful: boolean
+    dockslide: { state: string; homed: boolean; endstops: Record<string, string> } | null
+    tools: BtcTool[]
+    stats: {
+        changes_total: number
+        changes_print: number
+        failed_total: number
+        avg_time: number
+        last_time: number
+        last_result: '' | 'ok' | 'fail'
+        tools_used_print: number[]
+    }
+    log: BtcLogEntry[]
+    errors: string[]
+}
+
+export type BtcToolKind = 'active' | 'standby' | 'docked'
+
+export interface BtcToolLook {
+    color: string | null // '#rrggbb' or null when unknown
+    material: string
+    spool: ServerSpoolmanStateSpool | null
+}
+
+// used only with an add-on older than 0.2.0, which does not publish presets
+const BTC_FALLBACK_PRESETS: BtcPreset[] = [
+    { label: 'Standby', temp: 150 },
+    { label: 'PLA', temp: 215 },
+    { label: 'PETG', temp: 240 },
+    { label: 'ABS', temp: 255 },
+]
+
+@Component
+export default class BtcToolchangerMixin extends BaseMixin {
+    get btc(): BtcStatus | null {
+        return this.$store.state.printer?.btc_dashboard ?? null
+    }
+
+    get btcTools(): BtcTool[] {
+        return this.btc?.tools ?? []
+    }
+
+    get btcActiveTool(): number {
+        return this.btc?.active_tool ?? -1
+    }
+
+    get btcBusy(): boolean {
+        return this.btc?.busy ?? false
+    }
+
+    // Tool changes and offset edits are blocked while a print runs or a change is in progress
+    get btcLocked(): boolean {
+        return this.printerIsPrinting || this.btcBusy || !this.klipperReadyForGui
+    }
+
+    get btcUseSpoolman(): boolean {
+        const mode = this.btc?.config?.spoolman ?? 'auto'
+        if (mode === 'no') return false
+        return this.moonrakerComponents.includes('spoolman')
+    }
+
+    get btcSpools(): ServerSpoolmanStateSpool[] {
+        return this.$store.state.server.spoolman?.spools ?? []
+    }
+
+    get btcView() {
+        return this.$store.state.gui.view.btcToolchanger
+    }
+
+    btcToolKind(tool: BtcTool): BtcToolKind {
+        if (tool.active) return 'active'
+        return tool.target > 0 ? 'standby' : 'docked'
+    }
+
+    btcToolLook(tool: BtcTool): BtcToolLook {
+        const spool =
+            this.btcUseSpoolman && tool.spool_id !== null
+                ? (this.btcSpools.find((s) => s.id === Number(tool.spool_id)) ?? null)
+                : null
+
+        if (spool) {
+            const f = spool.filament
+            return {
+                color: f?.color_hex ? '#' + f.color_hex.replace(/^#/, '').slice(0, 6) : null,
+                material: [f?.material, f?.name].filter(Boolean).join(' ') || `Spool #${spool.id}`,
+                spool,
+            }
+        }
+
+        // colour/material set in this panel (stored in Mainsail's settings)
+        const local = this.btcView?.tools?.[tool.name] ?? null
+        if (local?.color || local?.material) {
+            return { color: local.color || null, material: local.material || '', spool: null }
+        }
+
+        // Mainsail's own convention: variable_color on the Tn macro
+        const macro = this.$store.state.printer?.[`gcode_macro ${tool.name}`] ?? {}
+        const macroColor = macro.color ?? macro.colour ?? null
+        const color =
+            typeof macroColor === 'string' && /^#?[0-9a-f]{6}/i.test(macroColor)
+                ? '#' + macroColor.replace(/^#/, '').slice(0, 6)
+                : null
+
+        return { color, material: tool.spool_id !== null ? `Spool #${tool.spool_id}` : '', spool: null }
+    }
+
+    btcPresets(tool: BtcTool): BtcPreset[] {
+        return tool.presets ?? this.btc?.config?.default_presets ?? BTC_FALLBACK_PRESETS
+    }
+
+    // print temperature of the filament on the tool's Spoolman spool, if it has one
+    btcSpoolTemp(tool: BtcTool): number | null {
+        const temp = this.btcToolLook(tool).spool?.filament?.settings_extruder_temp
+        return typeof temp === 'number' && temp > 0 ? Math.round(temp) : null
+    }
+
+    btcSend(gcode: string, loading: string | null = null) {
+        this.$store.dispatch('server/addEvent', { message: gcode, type: 'command' })
+        this.$socket.emit('printer.gcode.script', { script: gcode }, { loading })
+    }
+
+    btcFormatTemp(value: number | null): string {
+        return value === null || value === undefined ? '--' : Math.round(value).toString()
+    }
+
+    btcFormatFan(value: number | null): string {
+        return value === null || value === undefined ? '--' : `${Math.round(value * 100)}%`
+    }
+}
