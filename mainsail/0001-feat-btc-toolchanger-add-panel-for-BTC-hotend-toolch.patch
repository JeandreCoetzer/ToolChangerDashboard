+        return this.btc?.carriage === 'PRESSED'
+            ? this.$t('Panels.BtcToolchangerPanel.Locked')
+            : this.$t('Panels.BtcToolchangerPanel.Empty')
+    }
+
+    get carriageMismatch() {
+        const c = this.btc?.carriage
+        if (!c) return false
+        return (c === 'PRESSED') !== this.btcActiveTool >= 0
+    }
+
+    get carriageDotClass() {
+        if (this.carriageMismatch) return 'error'
+        return this.btc?.carriage === 'PRESSED' ? 'success' : ''
+    }
+
+    get dockslideText() {
+        const ds = this.btc?.dockslide
+        if (!ds) return ''
+        const state = this.$t(`Panels.BtcToolchangerPanel.DockslideState.${ds.state}`).toString()
+        return ds.homed ? state : `${state} (${this.$t('Panels.BtcToolchangerPanel.NotHomed')})`
+    }
+
+    openTool(n: number) {
+        this.selectedTool = n
+        this.showToolDialog = true
+    }
+}
+</script>
