+}
+
+.btc-grid {
+  display: grid;
+  gap: 8px;
+}
+
+.btc-actions {
+  gap: 8px;
+}
+
+.btc-mono {
+  font-family: 'Roboto Mono', monospace;
+}
+
+.btc-log-row {
+  display: grid;
+  grid-template-columns: 80px 100px 56px minmax(0, 1fr) 40px;
+  gap: 8px;
+  padding: 3px 0;
+  border-bottom: 1px solid rgba(128, 128, 128, 0.15);
+}
+
+.btc-log-detail {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.btc-chip {
+  font-weight: 700;
+  letter-spacing: 0.5px;
+}
+</style>
