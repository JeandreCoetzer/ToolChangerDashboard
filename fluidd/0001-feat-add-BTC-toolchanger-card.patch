+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import BtcToolchangerMixin from '@/mixins/btcToolchanger'
+import BtcToolchangerTile from './BtcToolchangerTile.vue'
+import BtcToolchangerToolDialog from './BtcToolchangerToolDialog.vue'
+import BtcToolchangerSettings from './BtcToolchangerSettings.vue'
+
+const LOG_ROWS = 10
+const MAX_AUTO_COLUMNS = 4
+const SIX_TOOL_COLUMNS = 3
+
+@Component({
+  components: {
+    BtcToolchangerTile,
+    BtcToolchangerToolDialog,
+    BtcToolchangerSettings
+  }
+})
+export default class BtcToolchangerCard extends Mixins(BtcToolchangerMixin) {
+  showToolDialog = false
+  selectedTool: number | null = null
+
+  get errors (): string[] {
+    return this.btc?.errors ?? []
+  }
+
+  get log (): Klipper.BtcDashboardLogEntry[] {
+    return (this.btc?.log ?? []).slice(0, LOG_ROWS)
+  }
+
+  get changesLabel (): string {
+    return this.printerPrinting || this.printerPaused
+      ? this.$t('app.btc_toolchanger.label.changes_this_print').toString()
+      : this.$t('app.btc_toolchanger.label.changes').toString()
+  }
+
+  get changeCount (): number {
+    const stats = this.btc?.stats
+
+    if (!stats) return 0
+
+    return this.printerPrinting || this.printerPaused ? stats.changes_print : stats.changes_total
+  }
+
+  get columns (): number {
+    const setting = this.btcSettings.columns
+
+    if (setting !== 'auto') return setting
+
+    const count = this.btcTools.length
+
+    if (count <= MAX_AUTO_COLUMNS) return Math.max(count, 1)
+    if (count <= 6) return SIX_TOOL_COLUMNS
+
+    return MAX_AUTO_COLUMNS
+  }
+
+  get gridStyle (): Record<string, string> {
+    return { gridTemplateColumns: `repeat(${this.columns}, minmax(0, 1fr))` }
+  }
+
+  get chipText (): string {
+    if (this.btcActiveTool < 0) return this.$t('app.btc_toolchanger.label.carriage_empty').toString()
+
+    return this.$t('app.btc_toolchanger.label.tool_active', { name: `T${this.btcActiveTool}` }).toString()
+  }
+
+  get carriageText (): string {
+    return this.btc?.carriage === 'PRESSED'
+      ? this.$t('app.btc_toolchanger.label.locked').toString()
+      : this.$t('app.btc_toolchanger.label.empty').toString()
+  }
+
+  get carriageMismatch (): boolean {
+    const carriage = this.btc?.carriage
+
+    if (!carriage) return false
+
+    return (carriage === 'PRESSED') !== (this.btcActiveTool >= 0)
+  }
+
+  get carriageDotClass (): string {
+    if (this.carriageMismatch) return 'error'
+
+    return this.btc?.carriage === 'PRESSED' ? 'success' : ''
+  }
+
+  get dockslideText (): string {
+    const dockslide = this.btc?.dockslide
+
+    if (!dockslide) return ''
+
+    const state = this.$t(`app.btc_toolchanger.dockslide.${dockslide.state}`).toString()
+
+    return dockslide.homed
+      ? state
+      : `${state} (${this.$t('app.btc_toolchanger.label.not_homed')})`
+  }
+
+  openTool (n: number) {
+    this.selectedTool = n
+    this.showToolDialog = true
+  }
+}
+</script>
