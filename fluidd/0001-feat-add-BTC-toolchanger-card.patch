+      </v-list-item>
+
+      <v-list-item @click="showStatus = !showStatus">
+        <v-list-item-action class="my-0">
+          <v-checkbox :input-value="showStatus" />
+        </v-list-item-action>
+        <v-list-item-content>
+          <v-list-item-title>
+            {{ $t('app.btc_toolchanger.label.show_status') }}
+          </v-list-item-title>
+        </v-list-item-content>
+      </v-list-item>
+
+      <v-list-item @click="showActions = !showActions">
+        <v-list-item-action class="my-0">
+          <v-checkbox :input-value="showActions" />
+        </v-list-item-action>
+        <v-list-item-content>
+          <v-list-item-title>
+            {{ $t('app.btc_toolchanger.label.show_actions') }}
+          </v-list-item-title>
+        </v-list-item-content>
+      </v-list-item>
+
+      <v-list-item @click="showLog = !showLog">
+        <v-list-item-action class="my-0">
+          <v-checkbox :input-value="showLog" />
+        </v-list-item-action>
+        <v-list-item-content>
+          <v-list-item-title>
+            {{ $t('app.btc_toolchanger.label.show_log') }}
+          </v-list-item-title>
+        </v-list-item-content>
+      </v-list-item>
+    </v-list>
+  </v-menu>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import BtcToolchangerMixin from '@/mixins/btcToolchanger'
+import type { BtcToolchangerColumns } from '@/store/config/types'
+
+const COLUMN_CHOICES: BtcToolchangerColumns[] = [2, 3, 4, 6, 8]
+
+@Component({})
+export default class BtcToolchangerSettings extends Mixins(BtcToolchangerMixin) {
+  get columnItems (): { text: string, value: BtcToolchangerColumns }[] {
+    return [
+      { text: this.$t('app.btc_toolchanger.label.auto').toString(), value: 'auto' },
+      ...COLUMN_CHOICES.map(value => ({ text: value.toString(), value }))
+    ]
+  }
+
+  save (key: string, value: unknown) {
+    this.$typedDispatch('config/saveByPath', {
+      path: `uiSettings.btcToolchanger.${key}`,
+      value,
+      server: true
+    })
+  }
+
+  get columns (): BtcToolchangerColumns {
+    return this.btcSettings.columns
+  }
+
+  set columns (value: BtcToolchangerColumns) {
+    this.save('columns', value)
+  }
+
+  get showStatus (): boolean {
+    return this.btcSettings.showStatus
+  }
+
+  set showStatus (value: boolean) {
+    this.save('showStatus', value)
+  }
+
+  get showActions (): boolean {
+    return this.btcSettings.showActions
+  }
+
+  set showActions (value: boolean) {
+    this.save('showActions', value)
+  }
+
+  get showLog (): boolean {
+    return this.btcSettings.showLog
+  }
+
+  set showLog (value: boolean) {
+    this.save('showLog', value)
+  }
+}
+</script>
