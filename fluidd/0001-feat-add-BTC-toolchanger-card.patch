@@ -0,0 +1,122 @@
+import Component from 'vue-class-component'
+import { Mixins } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import type { Spool } from '@/store/spoolman/types'
+import type { BtcToolchangerConfig } from '@/store/config/types'
+
+export type BtcToolKind = 'active' | 'standby' | 'docked'
+
+export interface BtcToolLook {
+  color: string | null;
+  material: string;
+  spool: Spool | null;
+}
+
+// used only with an add-on older than 0.2.0, which does not publish presets
+const BTC_FALLBACK_PRESETS: Klipper.BtcDashboardPreset[] = [
+  { label: 'Standby', temp: 150 },
+  { label: 'PLA', temp: 215 },
+  { label: 'PETG', temp: 240 },
+  { label: 'ABS', temp: 255 }
+]
+
+const HEX_COLOR = /^#?([0-9a-f]{6})/i
+export const BTC_MAX_TEMP = 350
+export const BTC_MAX_OFFSET = 20
+
+@Component
+export default class BtcToolchangerMixin extends Mixins(StateMixin) {
+  get btc (): Klipper.BtcDashboardState | undefined {
+    return this.$typedState.printer.printer.btc_dashboard
+  }
+
+  get btcTools (): Klipper.BtcDashboardToolState[] {
+    return this.btc?.tools ?? []
+  }
+
+  get btcActiveTool (): number {
+    return this.btc?.active_tool ?? -1
+  }
+
+  get btcBusy (): boolean {
+    return this.btc?.busy ?? false
+  }
+
+  // tool changes, offsets and action buttons are blocked during a print or a running change
+  get btcLocked (): boolean {
+    return !this.klippyReady || this.printerPrinting || this.printerPaused || this.btcBusy
+  }
+
+  get btcUseSpoolman (): boolean {
+    if (this.btc?.config.spoolman === 'no') return false
+
+    return this.$typedGetters['server/componentSupport']('spoolman')
+  }
+
+  get btcSettings (): BtcToolchangerConfig {
+    return this.$typedState.config.uiSettings.btcToolchanger
+  }
+
+  btcToolKind (tool: Klipper.BtcDashboardToolState): BtcToolKind {
+    if (tool.active) return 'active'
+
+    return tool.target > 0 ? 'standby' : 'docked'
+  }
+
+  btcToolLook (tool: Klipper.BtcDashboardToolState): BtcToolLook {
+    const spool = this.btcUseSpoolman && tool.spool_id != null
+      ? this.$typedGetters['spoolman/getSpoolById'](Number(tool.spool_id)) ?? null
+      : null
+
+    if (spool) {
+      const filament = spool.filament
+
+      return {
+        color: this.btcNormaliseColor(filament.color_hex),
+        material: [filament.material, filament.name].filter(Boolean).join(' ') || `#${spool.id}`,
+        spool
+      }
+    }
+
+    const local = this.btcSettings.tools[tool.name]
+
+    if (local && (local.color || local.material)) {
+      return { color: this.btcNormaliseColor(local.color), material: local.material, spool: null }
+    }
+
+    // same convention Fluidd's tool buttons use: variable_color on the Tn macro
+    const macro = this.$typedGetters['macros/getMacroByName'](tool.name)
+    const macroColor = macro?.variables?.color ?? macro?.variables?.colour
+
+    return {
+      color: typeof macroColor === 'string' ? this.btcNormaliseColor(macroColor) : null,
+      material: tool.spool_id != null ? `#${tool.spool_id}` : '',
+      spool: null
+    }
+  }
+
+  btcNormaliseColor (value?: string | null): string | null {
+    const match = HEX_COLOR.exec(value ?? '')
+
+    return match ? `#${match[1]}` : null
+  }
+
+  btcPresets (tool: Klipper.BtcDashboardToolState): Klipper.BtcDashboardPreset[] {
+    return tool.presets ?? this.btc?.config.default_presets ?? BTC_FALLBACK_PRESETS
+  }
+
+  // print temperature of the filament on the tool's Spoolman spool, if it has one
+  btcSpoolTemp (tool: Klipper.BtcDashboardToolState): number | null {
+    const temp = this.btcToolLook(tool).spool?.filament.settings_extruder_temp
+
+    return typeof temp === 'number' && temp > 0 ? Math.round(temp) : null
+  }
+
+  btcFormatTemp (value: number | null): string {
+    return value == null ? '--' : Math.round(value).toString()
+  }
+
+  btcFormatFan (value: number | null): string {
+    return value == null ? '--' : `${Math.round(value * 100)}%`
+  }
+}
