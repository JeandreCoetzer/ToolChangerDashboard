+      fill="#b7bcc4"
+    />
+    <rect
+      x="16"
+      y="50"
+      width="28"
+      height="14"
+      rx="2"
+      :fill="blockColor"
+    />
+    <path
+      d="M24 64h12l-4 8h-4z"
+      fill="#c9a24a"
+    />
+    <circle
+      v-if="glow"
+      cx="30"
+      cy="75"
+      r="5"
+      :fill="glow"
+    />
+  </svg>
+</template>
+
+<script lang="ts">
+import { Component, Prop, Vue } from 'vue-property-decorator'
+import type { BtcToolKind } from '@/mixins/btcToolchanger'
+
+const FIN_POSITIONS = [14, 20, 26, 32, 38]
+const NO_FILAMENT_COLOR = '#777777'
+
+@Component({})
+export default class BtcToolchangerHotend extends Vue {
+  @Prop({ type: String, default: null })
+  readonly color!: string | null
+
+  @Prop({ type: String, default: 'docked' })
+  readonly kind!: BtcToolKind
+
+  @Prop({ type: Number, default: 52 })
+  readonly width!: number
+
+  @Prop({ type: Number, default: 70 })
+  readonly height!: number
+
+  get fins (): number[] {
+    return FIN_POSITIONS
+  }
+
+  get filament (): string {
+    return this.color ?? NO_FILAMENT_COLOR
+  }
+
+  get blockColor (): string {
+    if (this.kind === 'active') return '#d84315'
+    if (this.kind === 'standby') return '#b86b2a'
+
+    return '#4a4f57'
+  }
+
+  get glow (): string | null {
+    if (this.kind === 'active') return 'rgba(255, 112, 67, 0.55)'
+    if (this.kind === 'standby') return 'rgba(255, 152, 0, 0.3)'
+
+    return null
+  }
+}
+</script>
