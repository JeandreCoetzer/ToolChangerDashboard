+}
+
+.btc-num {
+  max-width: 110px;
+}
+
+.btc-material {
+  max-width: 180px;
+}
+
+.btc-swatch {
+  flex-shrink: 0;
+  width: 18px;
+  height: 18px;
+  border-radius: 4px;
+  border: 1px solid rgba(128, 128, 128, 0.6);
+}
+
+.btc-color {
+  width: 40px;
+  height: 30px;
+  padding: 2px;
+  border: 1px solid rgba(128, 128, 128, 0.5);
+  border-radius: 4px;
+  background: transparent;
+}
+
+@media (max-width: 480px) {
+  .btc-dlg-top {
+    flex-direction: column;
+  }
+
+  .btc-dlg-hero {
+    width: 100%;
+    height: 120px;
+    margin: 0 0 12px 0 !important;
+  }
+}
+</style>
