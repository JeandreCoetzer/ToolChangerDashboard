+<script lang="ts">
+import { Component, Mixins, Prop } from 'vue-property-decorator'
+import BtcToolchangerMixin, { type BtcToolKind, type BtcToolLook } from '@/mixins/btcToolchanger'
+import BtcToolchangerHotend from './BtcToolchangerHotend.vue'
+
+@Component({
+  components: {
+    BtcToolchangerHotend
+  }
+})
+export default class BtcToolchangerTile extends Mixins(BtcToolchangerMixin) {
+  @Prop({ type: Object, required: true })
+  readonly tool!: Klipper.BtcDashboardToolState
+
+  get kind (): BtcToolKind {
+    return this.btcToolKind(this.tool)
+  }
+
+  get look (): BtcToolLook {
