+<script lang="ts">
+import { Component, Mixins, Prop, VModel, Watch } from 'vue-property-decorator'
+import BtcToolchangerMixin, {
+  BTC_MAX_OFFSET,
+  BTC_MAX_TEMP,
+  type BtcToolKind,
+  type BtcToolLook
+} from '@/mixins/btcToolchanger'
+import BtcToolchangerHotend from './BtcToolchangerHotend.vue'
+
+type Axis = 'x' | 'y' | 'z'
+
+const DEFAULT_LOCAL_COLOR = '#777777'
+
+@Component({
+  components: {
+    BtcToolchangerHotend
+  }
+})
+export default class BtcToolchangerToolDialog extends Mixins(BtcToolchangerMixin) {
+  @VModel({ type: Boolean })
+  open?: boolean
+
+  @Prop({ type: Number, default: null })
+  readonly toolNumber!: number | null
+
+  axes: Axis[] = ['x', 'y', 'z']
+  offsets: Record<Axis, number> = { x: 0, y: 0, z: 0 }
+  targetInput = 0
+  localMaterial = ''
+  localColor = DEFAULT_LOCAL_COLOR
+
+  get maxTemp (): number {
+    return BTC_MAX_TEMP
+  }
+
+  get tool (): Klipper.BtcDashboardToolState | null {
+    return this.btcTools.find(tool => tool.n === this.toolNumber) ?? null
+  }
+
+  get kind (): BtcToolKind {
+    return this.tool ? this.btcToolKind(this.tool) : 'docked'
+  }
+
+  get look (): BtcToolLook {
+    return this.tool ? this.btcToolLook(this.tool) : { color: null, material: '', spool: null }
+  }
+
+  get title (): string {
+    if (!this.tool) return ''
+
+    return this.look.material ? `${this.tool.name} · ${this.look.material}` : this.tool.name
+  }
+
+  get presets (): Klipper.BtcDashboardPreset[] {
+    return this.tool ? this.btcPresets(this.tool) : []
+  }
+
+  get spoolTemp (): number | null {
+    return this.tool ? this.btcSpoolTemp(this.tool) : null
+  }
+
+  get presetsSourceText (): string {
+    if (!this.tool) return ''
+
+    const source = this.tool.presets_source ?? 'default'
+
+    return this.$t(`app.btc_toolchanger.msg.presets_source.${source}`, { n: this.tool.n }).toString()
+  }
+
+  get stateText (): string {
+    if (!this.tool) return ''
+
+    const base = this.$t(`app.btc_toolchanger.state_long.${this.kind}`).toString()
+
+    if (this.kind === 'active') return base
+    if (this.tool.docked === true) return `${base} · ${this.$t('app.btc_toolchanger.label.in_dock')}`
+    if (this.tool.docked === false) return `${base} · ${this.$t('app.btc_toolchanger.label.not_in_dock')}`
+
+    return base
+  }
+
+  get stateClass (): string {
+    if (this.kind === 'active') return 'primary--text'
+    if (this.kind === 'standby') return 'warning--text'
+
+    return ''
+  }
+
+  get shaperText (): string {
+    const shaper = this.tool?.shaper
+
+    if (!shaper?.type_x) return '--'
+
+    return `${shaper.type_x} ${shaper.freq_x} / ${shaper.type_y} ${shaper.freq_y} Hz`
+  }
+
+  get offsetsValid (): boolean {
+    return this.axes.every(axis => {
+      const value = this.offsets[axis]
+
+      return typeof value === 'number' && !isNaN(value) && Math.abs(value) <= BTC_MAX_OFFSET
+    })
+  }
+
+  get offsetHint (): string {
+    if (!this.tool) return ''
+
+    return this.btc?.config.save_offsets
+      ? this.$t('app.btc_toolchanger.msg.offsets_saved', { n: this.tool.n }).toString()
+      : this.$t('app.btc_toolchanger.msg.offsets_temporary', { n: this.tool.n }).toString()
+  }
+
+  get selectBlockedByPrint (): boolean {
+    return this.btcLocked && this.tool?.active !== true
+  }
+
+  get selectText (): string {
+    if (!this.tool) return ''
+    if (this.tool.active) return this.$t('app.btc_toolchanger.btn.on_carriage').toString()
+
+    return this.$t('app.btc_toolchanger.btn.select', { name: this.tool.name }).toString()
+  }
+
+  @Watch('open')
+  onOpen (value: boolean) {
+    if (value) this.resetInputs()
+  }
+
+  @Watch('toolNumber')
+  onToolNumberChanged () {
+    this.resetInputs()
+  }
+
+  resetInputs () {
+    const tool = this.tool
+
+    if (!tool) return
+
+    this.offsets = { x: tool.xoffset, y: tool.yoffset, z: tool.zoffset }
+    this.targetInput = Math.round(tool.target)
+
+    const local = this.btcSettings.tools[tool.name]
+
+    this.localMaterial = local?.material ?? ''
+    this.localColor = this.btcNormaliseColor(local?.color) ?? this.look.color ?? DEFAULT_LOCAL_COLOR
+  }
+
+  setTemp (value: number) {
+    if (!this.tool) return
+
+    const target = Math.max(0, Math.min(BTC_MAX_TEMP, Math.round(Number(value) || 0)))
+
+    this.targetInput = target
+    this.sendGcode(`SET_HEATER_TEMPERATURE HEATER=${this.tool.extruder} TARGET=${target}`)
+  }
+
+  saveOffsets () {
+    if (!this.tool || !this.offsetsValid) return
+
+    const { x, y, z } = this.offsets
+
+    this.sendGcode(`BTC_DASHBOARD_SET_OFFSET TOOL=${this.tool.n} X=${x} Y=${y} Z=${z}`)
+  }
+
+  saveLocal () {
+    if (!this.tool) return
+
+    this.$typedDispatch('config/saveByPath', {
+      path: `uiSettings.btcToolchanger.tools.${this.tool.name}`,
+      value: { material: this.localMaterial.trim(), color: this.localColor },
+      server: true
+    })
+  }
+
+  changeSpool () {
+    if (!this.tool) return
+
+    this.$typedCommit('spoolman/setDialogState', {
+      show: true,
+      targetMacro: this.tool.name
+    })
+  }
+
+  selectTool () {
+    if (!this.tool) return
+
+    this.sendGcode(this.tool.name)
+    this.open = false
+  }
+
+  dropoff () {
+    if (!this.tool) return
+
+    this.sendGcode(`TOOL_DROPOFF TOOLNUMBER=${this.tool.n}`)
+    this.open = false
+  }
+}
+</script>
